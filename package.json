{
  "name": "minecraft-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A persistent, perception-bounded autonomous Minecraft agent.",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json && webpack --config webpack.viewer.cjs",
    "start": "node dist/main.js",
    "seed:house": "tsx src/seed-house-project.ts",
    "seed:mining": "tsx src/seed-mining-project.ts",
    "operator": "tsx src/operator-cli.ts",
    "world:snapshot": "tsx src/world-state-cli.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "mineflayer": "^4.37.1",
    "mineflayer-armor-manager": "2.0.1",
    "mineflayer-auto-eat": "5.0.3",
    "mineflayer-pathfinder": "^2.4.5",
    "openai": "^6.49.0",
    "prismarine-viewer": "^1.33.0",
    "socket.io": "^4.8.3",
    "vec3": "^0.1.10",
    "xstate": "^5.32.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "webpack": "5.101.3",
    "webpack-cli": "6.0.1"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "esbuild@0.28.1": true
  }
}

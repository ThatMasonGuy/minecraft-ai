# Use with: docker compose --env-file .env --env-file .env.test up -d --build
# Keep test state separate from the long-lived world and agent history.
WORLD_DATA_DIR=./test-state/world
AGENT_DATA_DIR=./test-state/agent
SNAPSHOT_DIR=./.minecraft-ai-snapshots
PLANNER_MODE=manual
PLANNER_TOOL_MODE=dry_run

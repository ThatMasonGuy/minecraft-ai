# OpenAI
OPENAI_API_KEY=
# Explicitly selected for the project's token allowance and high-volume use.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
WEB_SEARCH_ENABLED=true

# Minecraft
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=minecraft-ai
# Use microsoft for a licensed account, or offline only for an offline-mode server.
MC_AUTH=microsoft
# Leave empty to auto-detect.
MC_VERSION=1.21.4
VIEWER_ENABLED=true
VIEWER_PORT=3007
VIEWER_DISTANCE=3
VIEWER_MAX_FPS=30
VIEWER_MAX_PIXEL_RATIO=1.25

# Runtime
DATA_DIR=./data
AGENT_TICK_MS=5400000
PERCEPTION_DISTANCE=32
MAX_MOVE_DISTANCE=64
MAX_TOOL_ROUNDS=2
WORK_EXECUTOR_TICK_MS=3000
MAX_OUTPUT_TOKENS=512
DAILY_TOKEN_BUDGET=1000000
DAILY_TOKEN_RESERVE=150000
RECONNECT_DELAY_MS=10000
ALLOW_PLAYER_COMBAT=false

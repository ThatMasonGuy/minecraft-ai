# OpenAI
OPENAI_API_KEY=
# Cost-sensitive GPT-5.6 tier for high-volume autonomous planning.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
# manual disables automatic model wakeups; use !plan <task> for one-off turns.
PLANNER_MODE=manual
# dry_run records proposed tools without executing or continuing the model turn.
PLANNER_TOOL_MODE=dry_run
WEB_SEARCH_ENABLED=false

# Minecraft
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=minecraft-ai
# Use microsoft for a licensed account, or offline only for an offline-mode server.
MC_AUTH=microsoft
# Leave empty to auto-detect.
MC_VERSION=1.21.4
VIEWER_ENABLED=true
VIEWER_HOST=127.0.0.1
VIEWER_PORT=3007
VIEWER_DISTANCE=3
VIEWER_MAX_FPS=30
VIEWER_MAX_PIXEL_RATIO=1.25

# Local zero-cost task submission and explicit one-off planner calls.
OPERATOR_ENABLED=true
OPERATOR_HOST=127.0.0.1
OPERATOR_PORT=3008
# Optional override. Otherwise a 64-character token is created in DATA_DIR/operator-token.
# OPERATOR_TOKEN=

# Runtime
DATA_DIR=./data
AGENT_TICK_MS=5400000
# Hard lower bound between every paid planner request, including tool follow-ups.
PLANNER_MIN_REQUEST_INTERVAL_MS=900000
PERCEPTION_DISTANCE=32
MAX_MOVE_DISTANCE=64
MAX_TOOL_ROUNDS=2
WORK_EXECUTOR_TICK_MS=3000
MAX_OUTPUT_TOKENS=512
DAILY_TOKEN_BUDGET=1000000
DAILY_TOKEN_RESERVE=150000
RECONNECT_DELAY_MS=10000
